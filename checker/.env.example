# Copy this file to ".env" in this folder and paste your keys:
#   cp .env.example .env
# ".env" is gitignored. Keys placed here are read by envkeys.py and are
# never printed or logged. A real environment variable of the same name
# takes precedence over the value in this file.

# Neuronpedia API key — REQUIRED to score activations (checker/score.py).
# Free: create an account at https://www.neuronpedia.org and copy the
# API key from the account / API section.
NEURONPEDIA_API_KEY=

# Anthropic API key — needed only to generate prompts with Claude
# (generation mode (a)) and for the register-rewrite helper. NOT needed
# when you pass --prompts-in with prompts written elsewhere.
# Get one at https://console.anthropic.com (API Keys).
ANTHROPIC_API_KEY=

# Optional: which Claude model generates prompts.
# Default is claude-sonnet-5-5; uncomment to override.
#CHECKER_MODEL=claude-sonnet-5-5
